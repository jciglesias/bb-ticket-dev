{
  "name": "bb-ticket-dev",
  "version": "1.0.0",
  "description": "Convex project for automatic ticket development using GitHub and BlackBox AI",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "predev": "convex dev --until-success",
    "build": "convex deploy --cmd 'npm run build:app'",
    "build:app": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "demo": "node src/examples/demo-simple.js",
    "demo:full": "ts-node src/examples/demo.ts",
    "demo:pr": "node src/examples/demo-pull-request.js",
    "test:pr": "node src/examples/test-pull-request.js",
    "test:blackbox": "node src/examples/test-blackbox.js"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2",
    "axios": "^1.6.2",
    "convex": "^1.14.1",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.19.13",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "convex",
    "github",
    "blackbox-ai",
    "automation",
    "ddd"
  ],
  "author": "",
  "license": "ISC"
}
